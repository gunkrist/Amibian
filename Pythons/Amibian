import subprocess
import sys
import os

# Define the file types to pythons
script_map = {
    '.zip': 'autorun_zip.py',
    '.hdf': 'autorun_hdf.py',
    '.adf': 'autorun_adf.py',
    '.iso': 'autorun_iso.py',
    '.lha': 'autorun_lha.py',
    '.cue': 'autorun_iso.py'
}

def get_script(file_extension):
    return script_map.get(file_extension, None)

def launch_script(file_path):
    # Determine the Amibian folder path
    script_dir = os.path.dirname(os.path.abspath(__file__))
    while True:
        if os.path.basename(script_dir) == "Amibian":
            break
        parent_dir = os.path.dirname(script_dir)
        if parent_dir == script_dir:
            raise FileNotFoundError("Amibian folder not found.")
        script_dir = parent_dir

    _, file_extension = os.path.splitext(file_path)
    script = get_script(file_extension)
    
    if script:
        script_path = os.path.join(script_dir, "Pythons", script)
        subprocess.run(['python3', script_path, file_path])
    else:
        print(f"Unsupported file type: {file_extension}")

if __name__ == "__main__":
    if len(sys.argv) != 2:
        # If no file path is provided, open the menu.py script in the Pythons folder
        script_dir = os.path.dirname(os.path.abspath(__file__))
        while True:
            if os.path.basename(script_dir) == "Amibian":
                break
            parent_dir = os.path.dirname(script_dir)
            if parent_dir == script_dir:
                raise FileNotFoundError("Amibian folder not found.")
            script_dir = parent_dir

        menu_script_path = os.path.join(script_dir, "Pythons", "menu.py")
        subprocess.run(['python3', menu_script_path])
    else:
        file_path = sys.argv[1]
        launch_script(file_path)
